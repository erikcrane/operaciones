# Plantilla de la configuración privada del correo.
# Cópiala como ".env" en la raíz del proyecto (junto a pyproject.toml) y
# rellénala:
#     cp .env.ejemplo .env
# El fichero .env NO se sube a git (está en .gitignore): cópialo a mano a
# cada ordenador. Formato: CLAVE=valor, sin espacios alrededor del "=".
#
# Un solo fichero sirve para todos los ejercicios. La cuenta SMTP y el
# remitente son comunes; solo los destinatarios pueden ser distintos para
# cada ejercicio, poniendo delante su nombre en mayúsculas y "_":
# DIVISIONES_DESTINATARIOS solo se usa para divisiones. Los ejercicios que
# no tengan los suyos usan DESTINATARIOS.

# --- Cuenta SMTP y remitente (comunes a todos los ejercicios) ---
SERVIDOR_SMTP=smtp-relay.brevo.com
# 465 con SEGURIDAD=ssl, o 587 con SEGURIDAD=tls (STARTTLS)
PUERTO_SMTP=465
SEGURIDAD=ssl
# El "Login" de Brevo (SMTP & API -> SMTP), algo como 123abc@smtp-brevo.com
USUARIO_SMTP=
# La "clave SMTP" generada en Brevo
CONTRASENA_SMTP=
# Remitente verificado en Brevo (la misma dirección para todos los ejercicios)
REMITENTE=
# Nombre que verá el destinatario. Cada ejercicio tiene el suyo en el código
# (NOMBRE_REMITENTE en su __init__.py); este solo se usa si alguno lo deja vacío.
NOMBRE_REMITENTE=

# --- Destinatarios (varios separados por comas) ---
# Se usan cuando se envía con -e sin dirección, y desde la página web.
# Generales, para los ejercicios que no tengan los suyos:
DESTINATARIOS=
# Propios de cada ejercicio (opcionales):
# MULTIPLICACIONES_DESTINATARIOS=
# DIVISIONES_DESTINATARIOS=
